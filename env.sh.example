# Machine-local paths. Copy to env.sh and edit; env.sh is gitignored.
#
#   cp env.sh.example env.sh
#
# Scripts source this via:  source "$(git rev-parse --show-toplevel)/env.sh"

# Root for datasets, checkpoints and run dirs.
export WMA_DATA_ROOT=/media/hdd1/physics-priors-latent-space

# Local HDF5 cache (fast disk). Differs between host and container.
export WMA_CACHE_DIR="$HOME/vsr-tmp/lewm-datasets"

# Scratch dir for logs written by the batch scripts.
export WMA_SCRATCH="$HOME/vsr-tmp"

# Virtualenv to activate. Leave empty to skip activation
# (e.g. inside a container where the venv is already active).
export WMA_VENV="$HOME/virtual_envs/lewm"

# ---- derived; usually no need to edit ----
export WMA_REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export WMA_LL_DATA="$WMA_DATA_ROOT/lunar-lander-data"
export WMA_LL_NETWORKS="$WMA_DATA_ROOT/lunar-lander-networks"
export STABLEWM_HOME="$WMA_LL_DATA"

if [ -n "$WMA_VENV" ] && [ -f "$WMA_VENV/bin/activate" ]; then
    source "$WMA_VENV/bin/activate"
fi
